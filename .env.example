# Required in production
AGRINIVARA_AUTH_SECRET=replace-with-a-long-random-secret

# IMPORTANT: direct HTTPS URL to the REAL 134 MB+ plant_disease_model.keras file.
# Do NOT use the Git LFS pointer URL. Hugging Face direct resolve URLs work well.
PLANT_DISEASE_MODEL_URL=https://YOUR-HOST/plant_disease_model.keras

# Optional SHA-256 verification for the model artifact.
PLANT_DISEASE_MODEL_SHA256=

# Optional local/custom storage path. Usually leave these defaults unchanged.
PLANT_DISEASE_MODEL_DIR=/app/runtime_models
PLANT_DISEASE_MODEL_PATH=/app/runtime_models/plant_disease_model.keras
PLANT_DISEASE_MODEL_DOWNLOAD_TIMEOUT=900
PLANT_DISEASE_MODEL_LOAD_WAIT_SECONDS=180

# Leave empty for single website deployment.
VITE_API_URL=
