# Git
.git
.git/**
.github

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Python environments
**/venv
**/.venv

# Testing
**/.pytest_cache
**/.coverage
**/htmlcov

# Node
frontend/node_modules
frontend/dist

# Logs
*.log

# Local data
backend/data

# Training scripts
backend/model/train_model.py
backend/disease/train_model.py

# Environment files
.env
.env.*
!.env.example

# IDE / OS
.vscode
.idea
.DS_Store

# Documentation not required in image
README_SIH_FINAL.md
